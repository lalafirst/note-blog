---
interface Props {
  currentPage: number;
  totalPages: number;
}

const { currentPage, totalPages } = Astro.props;

function pageHref(n: number) {
  return n <= 1 ? '/' : `/page/${n}/`;
}

const newerHref = currentPage > 1 ? pageHref(currentPage - 1) : null;
const olderHref = currentPage < totalPages ? pageHref(currentPage + 1) : null;
---

{(newerHref || olderHref) && (
  <nav class="pager">
    <span class="pager-side">
      {newerHref && <a href={newerHref}>新しい投稿</a>}
    </span>
    <span class="pager-side pager-side-right">
      {olderHref && <a href={olderHref}>過去の投稿</a>}
    </span>
  </nav>
)}
